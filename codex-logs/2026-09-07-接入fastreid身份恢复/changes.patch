@@ -0,0 +1,77 @@
+"""Tests for FastReID adapter preprocessing and gated identity gallery."""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+from robot_perception.common.types import FrameData
+from robot_perception.reid import AppearanceGallery, FastReIDEncoder, ReIDIdentityManager
+
+
+class _FakePredictor:
+    def __init__(self) -> None:
+        self.input = None
+
+    def __call__(self, tensor):
+        self.input = tensor
+        return np.asarray([[3.0, 4.0]], dtype=np.float32)
+
+
+def _frame() -> FrameData:
+    image = np.zeros((100, 200, 3), dtype=np.uint8)
+    image[:, :, 0] = 10
+    return FrameData("0000", 0, image, np.empty((0, 4)), None)
+
+
+def test_fastreid_encoder_crops_and_normalizes_without_importing_fastreid() -> None:
+    predictor = _FakePredictor()
+    encoder = FastReIDEncoder("unused.yml", "unused.pth", predictor=predictor)
+
+    embedding = encoder.encode(_frame(), np.asarray((50.0, 10.0, 150.0, 90.0)))
+
+    assert embedding is not None
+    np.testing.assert_allclose(embedding, (0.6, 0.8), atol=1e-6)
+    assert tuple(predictor.input.shape) == (1, 3, 256, 256)
+
+
+def test_gallery_match_requires_gap_and_similarity() -> None:
+    gallery = AppearanceGallery(momentum=0.0, max_age_frames=100)
+    gallery.update(7, 1, np.asarray((1.0, 0.0)), 0)
+
+    assert gallery.match(np.asarray((1.0, 0.0)), class_id=1, frame_id=5, min_similarity=0.9, min_gap_frames=10) is None
+    match = gallery.match(np.asarray((1.0, 0.0)), class_id=1, frame_id=10, min_similarity=0.9, min_gap_frames=10)
+    assert match is not None and match.track_id == 7
+
+
+def test_reid_manager_reactivates_only_after_reliable_embedding() -> None:
+    predictor = _FakePredictor()
+    manager = ReIDIdentityManager(
+        FastReIDEncoder("unused.yml", "unused.pth", predictor=predictor),
+        similarity_threshold=0.99,
+        min_gap_frames=3,
+        min_fusion_confidence=0.5,
+    )
+    frame = _frame()
+    first = manager.resolve(
+        internal_track_id=1, class_id=1, frame_id=0, frame=frame,
+        bbox=np.asarray((50.0, 10.0, 150.0, 90.0)), fusion_confidence=0.9,
+        active_public_ids=set(),
+    )
+    assert first.public_track_id == 1 and not first.reactivated
+    recovered = manager.resolve(
+        internal_track_id=9, class_id=1, frame_id=3, frame=frame,
+        bbox=np.asarray((50.0, 10.0, 150.0, 90.0)), fusion_confidence=0.9,
+        active_public_ids=set(),
+    )
+    assert recovered.public_track_id == 1
+    assert recovered.reactivated
+
+
+def test_reid_manager_does_not_reactivate_active_identity() -> None:
+    predictor = _FakePredictor()
+    manager = ReIDIdentityManager(FastReIDEncoder("unused.yml", "unused.pth", predictor=predictor), min_gap_frames=1)
+    frame = _frame()
+    manager.resolve(internal_track_id=1, class_id=1, frame_id=0, frame=frame, bbox=np.asarray((1, 1, 50, 50)), fusion_confidence=1.0, active_public_ids=set())
+    decision = manager.resolve(internal_track_id=9, class_id=1, frame_id=5, frame=frame, bbox=np.asarray((1, 1, 50, 50)), fusion_confidence=1.0, active_public_ids={1})
+    assert decision.public_track_id == 9
diff --git a/weights/README.md b/weights/README.md
new file mode 100644
index 0000000..588a44e
--- /dev/null
+++ b/weights/README.md
@@ -0,0 +1,532 @@
+# robot-perception-mot
+
+面向 KITTI Tracking 的 Camera-LiDAR 3D 感知与多目标跟踪工程。项目将数据读取、
+点云预处理、坐标变换、检测适配、状态估计、数据关联、轨迹生命周期、跨模态一致性
+检查、离线可视化和 ROS2 replay 保持为职责明确的模块。
+
+
+## 1. Project Overview
+
+系统以 KITTI Tracking 的图像、Velodyne 点云、标定和标签为输入，提供：
+
+- KITTI Tracking 的标准目录与分拆下载目录读取；
+- ROI、Voxel、离群点过滤与 RANSAC 地面分割；
+- KITTI 标定解析及向量化 LiDAR -> Camera -> Rectified Camera -> Image 投影；
+- 独立实现的 3D Constant Velocity Kalman Filter；
+- Mahalanobis gating、Hungarian assignment 与 Track 生命周期；
+- GT/NoisyGT/PointPillars 输出适配，以及实验性 Camera-LiDAR object-level fusion；
+- 可复现的 baseline benchmark、深度着色可视化、MP4 和 ROS2 Humble replay。
+
+## 2. Motivation
+
+机器人感知工程的难点不只在单个模型，而在传感器数据、坐标系、时间序列状态和
+可观测结果之间建立可靠边界。本项目使用成熟的 KITTI 数据和公开 PointPillars 权重，
+将重点放在可测试的 3D tracking 与多传感器几何流程上。
+
+## 3. System Architecture
+
+```mermaid
+flowchart LR
+    K[KITTI Tracking] --> D[Dataset Loader]
+    D --> I[Camera Image]
+    D --> P[Raw LiDAR N x 4]
+    D --> C[Calibration P2/R0_rect/Tr_velo_to_cam]
+    P --> PP[Point Cloud Preprocess]
+    P --> DET[3D Detector Adapter]
+    DET --> T[ROS-independent MOT Core]
+    T --> TS[TrackState]
+    C --> PROJ[3D-to-2D Projection]
+    DET --> PROJ
+    I --> CAM[Camera 2D Detection]
+    PROJ --> ASSOC[Cross-modal Association]
+    CAM --> ASSOC
+    ASSOC --> F[Object-level FusedDetection]
+    P --> V[Depth-coloured Visualization]
+    PP --> V
+    T --> R[ROS2 Adapter / RViz]
+```
+
+模块之间通过 `FrameData`、`Detection3D`、`TrackState` 等 dataclass 通信。
+Tracker 不导入 `rclpy`，也不依赖具体 Detector。
+
+端到端执行顺序如下；benchmark 的三个 tracker 分支共享同一 detection stream：
+
+```mermaid
+flowchart TD
+    A[FrameData: image + raw LiDAR + labels] --> B[Preprocess / optional]
+    A --> C[Detector Adapter]
+    C --> D{Tracking method}
+    D --> D1[Baseline NN]
+    D --> D2[KF + Euclidean]
+    D --> D3[KF + Mahalanobis + Hungarian]
+    D1 --> E[TrackState]
+    D2 --> E
+    D3 --> E
+    A --> F[Calibration Projection]
+    F --> G[Camera 2D Association]
+    G --> H[FusedDetection]
+    E --> I[Metrics / ROS2 / Visualization]
+    H --> I
+```
+
+## 4. Dataset
+
+主数据集为 [KITTI Tracking](https://www.cvlibs.net/datasets/kitti/eval_tracking.php)，
+使用 `image_02`、`velodyne`、`calib`、`label_02`。当前默认配置位于
+`configs/dataset.yaml`，开发与已运行实验使用 sequence `0000`；配置也列出 `0001`
+和 `0002` 供后续扩展。
+
+- `FrameData.image`：OpenCV BGR 图像；
+- `FrameData.lidar_points`：`float32`，形状为 `N x 4`，列为 `[x, y, z, intensity]`；
+- KITTI Tracking 标签保留 `sequence_id`、`frame_id`、`track_id`、类别、2D bbox、
+  尺寸、位置与 `rotation_y`；
+- KITTI label 位置和 3D box 在 camera 坐标系，PointPillars 输出在 LiDAR 坐标系。
+
+## 5. Environment
+
+目标环境为 Ubuntu 22.04、ROS2 Humble、Python 3.10、PyTorch 2.1.2+cu118、
+CUDA 11.8。主项目与旧版 MMDetection3D PointPillars 使用**两套隔离环境**，
+不能混装。
+
+主项目已使用的核心版本：
+
+```text
+conda env: robot-perception-mot
+Python:    3.10
+PyTorch:   2.1.2+cu118
+NumPy:     1.26.4
+SciPy:     1.11.4
+ROS2:      Humble
+```
