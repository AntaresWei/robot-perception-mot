Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: LiDAR Points
      Size (Pixels): 2
      Style: Points
      Topic:
        Value: /sensors/lidar/points
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: 3D Detections
      Topic:
        Value: /perception/detections
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Tracks and IDs
      Topic:
        Value: /perception/tracks
  Global Options:
    Fixed Frame: base_link
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 60
      Pitch: 0.6
      Yaw: 0.8
